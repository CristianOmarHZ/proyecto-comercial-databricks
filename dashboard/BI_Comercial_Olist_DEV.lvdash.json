{
  "datasets": [
    {
      "name": "187ee899",
      "displayName": "KPIs_Mensuales",
      "queryLines": [
        "\r\n",
        "WITH resumen AS (\r\n",
        "    SELECT\r\n",
        "        DATE_TRUNC('MONTH', d.fecha) AS mes,\r\n",
        "        COUNT(*) AS total_pedidos,\r\n",
        "        COUNT(DISTINCT p.id_cliente_unico) AS clientes_unicos,\r\n",
        "\r\n",
        "        SUM(\r\n",
        "            CASE WHEN p.tiene_detalle = 1\r\n",
        "            THEN p.importe_articulos ELSE 0 END\r\n",
        "        ) AS ingresos_productos,\r\n",
        "\r\n",
        "        SUM(\r\n",
        "            CASE WHEN p.tiene_detalle = 1\r\n",
        "            THEN 1 ELSE 0 END\r\n",
        "        ) AS pedidos_con_venta,\r\n",
        "\r\n",
        "        SUM(\r\n",
        "            CASE WHEN p.tiene_detalle = 1\r\n",
        "            THEN p.cantidad_articulos ELSE 0 END\r\n",
        "        ) AS articulos_vendidos\r\n",
        "\r\n",
        "    FROM catalog_dev.golden.fact_pedidos p\r\n",
        "\r\n",
        "    INNER JOIN catalog_dev.golden.dim_fecha d\r\n",
        "        ON p.id_fecha = d.id_fecha\r\n",
        "\r\n",
        "    GROUP BY DATE_TRUNC('MONTH', d.fecha)\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "    DATE_FORMAT(mes, 'yyyy-MM') AS mes,\r\n",
        "    total_pedidos,\r\n",
        "    clientes_unicos,\r\n",
        "    ingresos_productos,\r\n",
        "    pedidos_con_venta,\r\n",
        "    articulos_vendidos,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        ingresos_productos /\r\n",
        "        NULLIF(pedidos_con_venta, 0),\r\n",
        "        2\r\n",
        "    ) AS ticket_promedio,\r\n",
        "\r\n",
        " \r\n",
        "CASE\r\n",
        "    WHEN pedidos_con_venta >= 500\r\n",
        "     AND LAG(pedidos_con_venta) OVER (ORDER BY mes) >= 500\r\n",
        "     AND MONTHS_BETWEEN(\r\n",
        "         mes,\r\n",
        "         LAG(mes) OVER (ORDER BY mes)\r\n",
        "     ) = 1\r\n",
        "    THEN ROUND(\r\n",
        "        100.0 * (\r\n",
        "            ingresos_productos\r\n",
        "            - LAG(ingresos_productos) OVER (ORDER BY mes)\r\n",
        "        ) /\r\n",
        "        NULLIF(\r\n",
        "            LAG(ingresos_productos) OVER (ORDER BY mes),\r\n",
        "            0\r\n",
        "        ),\r\n",
        "        2\r\n",
        "    )\r\n",
        "    ELSE NULL\r\n",
        "END AS crecimiento_mensual_pct\r\n",
        "\r\n",
        "\r\n",
        "FROM resumen\r\n",
        "WHERE mes >= DATE '2017-01-01'\r\n",
        "  AND mes < DATE '2018-09-01'\r\n",
        "ORDER BY mes;"
      ]
    },
    {
      "name": "843f3da8",
      "displayName": "KPIs_Generales",
      "queryLines": [
        "\r\n",
        "SELECT\r\n",
        "    ROUND(\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN tiene_detalle = 1\r\n",
        "                THEN COALESCE(importe_articulos, 0)\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        ), 2\r\n",
        "    ) AS ingresos_totales,\r\n",
        "\r\n",
        "    COUNT(*) AS total_pedidos,\r\n",
        "\r\n",
        "    COUNT(DISTINCT id_cliente_unico) AS clientes_unicos,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN tiene_detalle = 1\r\n",
        "                THEN COALESCE(importe_articulos, 0)\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        )\r\n",
        "        /\r\n",
        "        NULLIF(\r\n",
        "            SUM(\r\n",
        "                CASE\r\n",
        "                    WHEN tiene_detalle = 1 THEN 1\r\n",
        "                    ELSE 0\r\n",
        "                END\r\n",
        "            ), 0\r\n",
        "        ), 2\r\n",
        "    ) AS ticket_promedio\r\n",
        "\r\n",
        "FROM catalog_dev.golden.fact_pedidos;\r\n"
      ]
    }
  ],
